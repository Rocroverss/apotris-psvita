sources_asm = files(
    'libctru/source/svc.s',
    'libctru/source/system/readtp.s',
    'libctru/source/system/stack_adjust.s',
)

includes = include_directories('libctru/include')

libctru_asm = static_library(
    'ctru_asm',
    sources_asm,
    include_directories: includes,
    c_args: ['-xassembler-with-cpp'],
)

libctru = static_library(
    'ctru',
    sources,
    include_directories: includes,
)

libctru_dep = declare_dependency(
    include_directories: includes,
    link_with: [libctru, libctru_asm],
)
