project('libctru', ['c', 'cpp'],
    version: '2.7.0',
    license: 'MIT',
    meson_version: '>=1.1.0',
    default_options : ['cpp_std=gnu++11']
)

if get_option('profiling')
    message('Enabling profiling hooks')
    add_project_arguments('-DPROFILING', language: ['c', 'cpp'])
endif

